# Copy this to .env and fill in your own token.
# NEVER commit your real .env — it is gitignored.

# DeepSeek free chat token (from chat.deepseek.com, Authorization: Bearer <token>)
# Get it by logging into https://chat.deepseek.com in your browser,
# opening DevTools → Network, and copying the Bearer token.
DEEPSEEK_AUTH_TOKEN=your-deepseek-token-here

# Optional: backend port (default 8000)
PORT=8000

# Optional: official DeepSeek cloud API key (sk-...) for Agent cloud mode
# DEEPSEEK_API_KEY=sk-your-key-here

# Optional: OpenAI API key (sk-...) for Agent cloud mode
# OPENAI_API_KEY=sk-your-key-here

# Optional: restrict Agent workspace roots (comma-separated)
# AGENT_ALLOWED_ROOTS=C:\projects,D:\work
